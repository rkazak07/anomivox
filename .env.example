# ═════════════════════════════════════════════════════════════════════
# ANOMIVOX ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values
# ═════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# API KEYS (en az bir tane gerekli)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ─────────────────────────────────────────────
# DATABASE - PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=anomivox
POSTGRES_PORT=5432

# ─────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────
APP_MODE=api
DB_TYPE=postgresql
# Admin kullanıcısının varsayılan şifresi (ilk kurulumda kullanılır)
# Boş bırakılırsa rastgele şifre oluşturulur ve log'a yazılır
ADMIN_DEFAULT_PASSWORD=

# ─────────────────────────────────────────────
# Redis — Token Cache
# ─────────────────────────────────────────────
REDIS_PASSWORD=

# ─────────────────────────────────────────────
# LiteLLM — Model Proxy
# ─────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-anomivox-local

# ─────────────────────────────────────────────
# Telegram Bot (opsiyonel)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Virgülle ayrılmış ek chat ID'leri (opsiyonel)
TELEGRAM_CHAT_IDS=
# Multi-approval: onay yetkili DBA chat ID'leri (virgülle ayrılmış)
# Boş bırakılırsa TELEGRAM_ADMIN_CHAT_ID kullanılır
DBA_APPROVERS=
# HIGH risk aksiyonlar için gereken minimum onay sayısı (varsayılan: 1)
DBA_REQUIRED_APPROVALS=1

# ─────────────────────────────────────────────
# Discord / Slack (opsiyonel)
# ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# ─────────────────────────────────────────────
# DBA Agent — Genel Davranış
# ─────────────────────────────────────────────
# Arayüz dili: "tr" (Türkçe, varsayılan) veya "en" (İngilizce)
DBA_AGENT_LANGUAGE=tr
# Log seviyesi: DEBUG | INFO | WARNING | ERROR
DBA_LOG_LEVEL=INFO
# Tanımları otomatik başlat (true/false)
DBA_AUTO_DIAGNOSE=true

# ─────────────────────────────────────────────
# DBA Agent — Aksiyon Güvenliği
# ─────────────────────────────────────────────
# LOW riskli aksiyonları otomatik onayla (true/false)
DBA_AUTO_APPROVE_LOW=false
# Dry-run: aksiyonlar yürütülmez, sadece loglanır (true/false)
DBA_DRY_RUN=false
# Onay zaman aşımı (saniye, varsayılan: 3600)
DBA_APPROVAL_TIMEOUT=3600
# Aksiyon cooldown süresi (dakika, varsayılan: 30)
DBA_COOLDOWN_MINUTES=30
# Bakım penceresi — HIGH riskli aksiyonlar sadece bu saatler arasında uygulanır
# Format: HH:MM (24 saat). Boş bırakılırsa kısıtlama yoktur.
DBA_MAINTENANCE_START=
DBA_MAINTENANCE_END=

# ─────────────────────────────────────────────
# DBA Agent — LiteLLM / Model Konfigürasyonu
# ─────────────────────────────────────────────
LITELLM_BASE_URL=http://litellm-proxy:4000
LITELLM_API_KEY=sk-anomivox-local
OLLAMA_BASE_URL=http://192.168.1.202:11434
# Model tahsisi
DBA_REASONING_MODEL=ollama/llama3.1:8b
DBA_SQL_MODEL=ollama/sqlcoder:latest
DBA_TRIAGE_MODEL=ollama/llama3.2:1b
DBA_FALLBACK_MODEL=ollama/llama3:8b
# LLM timeout ve limit ayarları
DBA_REQUEST_TIMEOUT=300
DBA_MAX_CONTEXT=2048
DBA_MAX_OUTPUT=512
DBA_TEMPERATURE=0.1

# ─────────────────────────────────────────────
# DBA Agent — Veritabanı Bağlantı Fallback (ENV)
# Öncelik: configs/db_targets.json > aşağıdaki ENV değişkenleri
# ─────────────────────────────────────────────
DB_HOST=postgres_db
DB_PORT=5432
DB_USER=test
DB_PASSWORD=
DB_NAME=anomivox
DBA_DIAG_QUERY_TIMEOUT=10
DBA_ACTION_QUERY_TIMEOUT=60
DBA_MAX_CONNECTIONS=3

# ─────────────────────────────────────────────
# DBA Agent — SSH Hedefi (opsiyonel)
# Öncelik: db_targets.json ssh_enabled=true > aşağıdaki ENV değişkenleri
# ─────────────────────────────────────────────
DBA_SSH_HOST=
DBA_SSH_USER=anomivox
DBA_SSH_PORT=22
DBA_SSH_KEY_PATH=
DBA_SSH_NAME=db-server
DBA_SSH_ROLE=database
# Virgülle ayrılmış izin verilen servisler
DBA_SSH_ALLOWED_SERVICES=postgresql,mysql,nginx,docker
DBA_SSH_TIMEOUT=30

# ─────────────────────────────────────────────
# DBA Agent — İzleme Eşikleri
# ─────────────────────────────────────────────
MON_LONG_QUERY_SEC=30
MON_BLOCKED_LOCKS=1
MON_CONN_USAGE_PCT=85
MON_CACHE_HIT_MIN=85
MON_REPL_LAG_SEC=30
MON_CPU_PCT=90
MON_MEM_PCT=90
MON_DISK_PCT=90
MON_HEALTH_SCORE_MIN=60
MON_CHECK_INTERVAL=60
MON_ALERT_COOLDOWN=300

# ─────────────────────────────────────────────
# DBA Agent — Prometheus
# ─────────────────────────────────────────────
PROMETHEUS_URL=http://prometheus:9090
DBA_PROM_TIMEOUT=10

# ─────────────────────────────────────────────
# DBA Agent — Loglama
# ─────────────────────────────────────────────
# Audit log dosya yolu (varsayılan: logs/dba_agent_audit.jsonl)
DBA_AUDIT_LOG_PATH=

# ─────────────────────────────────────────────
# DBA Agent — Hafıza / Incident Store
# ─────────────────────────────────────────────
# JSON Lines incident log dosya yolu (varsayılan: logs/dba_incident_store.jsonl)
DBA_INCIDENT_LOG_PATH=
# ChromaDB veritabanı dizini (varsayılan: chroma_db/)
CHROMA_DB_PATH=
