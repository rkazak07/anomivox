# ═════════════════════════════════════════════════════════════════════
# ANOMIVOX ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in the values
# ═════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────
# API KEYS (en az bir tane gerekli)
# ─────────────────────────────────────────────
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# ─────────────────────────────────────────────
# DATABASE - PostgreSQL
# ─────────────────────────────────────────────
POSTGRES_USER=test
POSTGRES_PASSWORD=
POSTGRES_DB=anomivox
POSTGRES_PORT=5432

# ─────────────────────────────────────────────
# APPLICATION SETTINGS
# ─────────────────────────────────────────────
APP_MODE=api
DB_TYPE=postgresql
# Admin kullanıcısının varsayılan şifresi (ilk kurulumda kullanılır)
# Boş bırakılırsa rastgele şifre oluşturulur ve log'a yazılır
ADMIN_DEFAULT_PASSWORD=

# ─────────────────────────────────────────────
# LiteLLM — Model Proxy
# ─────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-anomivox-local

# ─────────────────────────────────────────────
# Telegram Bot (opsiyonel)
# ─────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ─────────────────────────────────────────────
# Discord / Slack (opsiyonel)
# ─────────────────────────────────────────────
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
