# ═══════════════════════════════════════════════════════════
# OpenClaw Gateway — Anomivox AI Assistant
# ═══════════════════════════════════════════════════════════
# Bu Dockerfile OpenClaw paketini build aşamasında kurar.
# Her restart'ta npm install yapılmaz, sadece rebuild gerekir.
# ═══════════════════════════════════════════════════════════

FROM node:22-bookworm

# Gerekli araçlar + gosu (uid switch)
RUN apt-get update && apt-get install -y curl jq gosu && rm -rf /var/lib/apt/lists/*

# OpenClaw'u global olarak kur (build aşamasında, bir kez)
RUN npm install -g openclaw@latest

# Çalışma dizini
WORKDIR /home/node

# Entrypoint script
COPY openclaw-entrypoint.sh /usr/local/bin/openclaw-entrypoint.sh
RUN chmod +x /usr/local/bin/openclaw-entrypoint.sh

# Volume mount noktalarını node kullanıcısı için hazırla
RUN mkdir -p /home/node/.openclaw/workspace/skills && \
    chown -R node:node /home/node/.openclaw

# Root olarak başlat — entrypoint chown yapıp gosu ile node'a geçer
# USER node kaldırıldı, entrypoint handle eder

# Port
EXPOSE 18789

ENTRYPOINT ["/usr/local/bin/openclaw-entrypoint.sh"]
