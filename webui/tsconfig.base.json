{
  // Setting files to empty prevents automatic scanning of default directories; only directories in include config will be scanned
  "files": [],
  "compilerOptions": {
    "target": "esnext",
    "module": "esnext",
    // Enable all strict type-checking options.
    // Enabling --strict is equivalent to enabling --noImplicitAny, --noImplicitThis, --alwaysStrict, --strictNullChecks, --strictFunctionTypes and --strictPropertyInitialization.
    "strict": true,
    // Allow the compiler to compile JS and JSX files
    "allowJs": false,
    // Report errors in JS files, usually used together with allowJs
    "checkJs": false,
    // Allow jsx usage
    "jsx": "preserve",
    "declaration": true,
    // Remove comments
    "removeComments": true,
    // Do not ignore any
    "noImplicitAny": false,
    // Disable this type annotation warnings
    "noImplicitThis": true,
    // null/undefined cannot be a subtype of other types:
    // let a: number = null; // This will cause an error.
    "strictNullChecks": true,
    // Generate enum mapping code
    "preserveConstEnums": true,
    // Root directory
    // Output directory
    "outDir": "./ts-out-dir",
    // Whether to output src2.js.map file
    "sourceMap": false,
    // Variable defined but not used
    "noUnusedLocals": false,
    // Whether to allow parsing json files as modules
    "resolveJsonModule": true,
    // Same as noUnusedLocals, but for functions
    "noUnusedParameters": false,
    // Module resolution strategy; ts uses node's resolution strategy by default, i.e., relative imports
    "moduleResolution": "node",
    // Allow export= syntax, imported by import from
    "esModuleInterop": true,
    // Ignore type checking for all declaration files (*.d.ts)
    "skipLibCheck": true,
    "baseUrl": ".",
    // Specify default directories to read from
    //"typeRoots": ["./node_modules/@types/", "./types"],
    "lib": ["ES2018", "DOM"]
  }
}
